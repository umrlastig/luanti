{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 12
    },
    "configurePresets": [
        {
            "name": "Debug",
            "displayName": "Debug",
            "description": "Debug preset with debug symbols and no optimizations",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TILTFIVE": "ON"
            }
        },
        {
            "name": "Release",
            "displayName": "Release",
            "description": "Release preset with optimizations and no debug symbols",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TILTFIVE": "ON"
            }
        },
        {
            "name": "RelWithDebInfo",
            "displayName": "RelWithDebInfo",
            "description": "Release with debug symbols",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "ENABLE_TILTFIVE": "ON"
            }
        },
        {
            "name": "MinSizeRel",
            "displayName": "MinSizeRel",
            "description": "Release with minimal code size",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "ENABLE_TILTFIVE": "ON"
            }
        }
    ],
    "buildPresets": [
    ]
}